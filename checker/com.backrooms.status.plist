<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: replace HOME_DIR with the machine's home (MacBook: /Users/user, Mac mini: /Users/ak), copy to
     ~/Library/LaunchAgents/, then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.backrooms.status.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.backrooms.status</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>HOME_DIR/.config/backrooms-status/check.py</string>
  </array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>HOME_DIR/.config/backrooms-status/check.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/.config/backrooms-status/check.log</string>
</dict>
</plist>
